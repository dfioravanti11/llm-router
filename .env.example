# Copy to .env and fill in. .env is gitignored; this file must never hold a
# real secret.

# ─── Needed from R0.3 (tokenization) ────────────────────────────
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_HOME=./.cache/huggingface          # keep model cache out of ~
MODEL_ID=Qwen/Qwen3-1.7B              # swap to Qwen3-8B at R0.5

# ─── Local stack (defaults fine, override per machine) ──────────
ROUTER_PORT=8080
METRICS_PORT=9090
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=changeme
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─── Rust ───────────────────────────────────────────────────────
RUST_LOG=warmpath=debug,warmpath_mock=info
RUST_BACKTRACE=1

# ─── R0.5+ only — leave empty until the GPU gate ────────────────
RUNPOD_API_KEY=
GPU_WORKER_1_URL=
GPU_WORKER_2_URL=
GPU_WORKER_1_ZMQ=                      # R0.7, KV event socket
GPU_WORKER_2_ZMQ=
